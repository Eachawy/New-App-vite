{
  "name": "common-portal",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "Common Portal frontend",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run webapp:prod --",
    "ci:frontend:test": "npm run webapp:build:$npm_package_config_default_environment && npm run test",
    "clean-www": "rimraf target/classes/static/",
    "cleanup": "rimraf target/",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "prettier:check": "prettier --check \"{,src/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,tsx,css,scss}\"",
    "prettier:format": "prettier --write \"{,src/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,tsx,css,scss}\"",
    "sonar": "sonar-scanner",
    "start": "npm run webapp:dev --",
    "pretest": "npm run lint && npm run typecheck",
    "test": "npm run vitest-run --",
    "test:watch": "npm run vitest --",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vitest.json",
    "vitest": "vitest",
    "vitest-run": "vitest run --coverage",
    "webapp:build": "npm run clean-www && npm run webapp:build:dev --",
    "webapp:build:dev": "vite build",
    "webapp:build:prod": "vite build",
    "webapp:dev": "vite",
    "webapp:prod": "npm run clean-www && npm run webapp:build:prod --",
    "webapp:test": "npm run test --"
  },
  "lint-staged": {
    "{,src/**/}*.{md,json,yml,html,css,scss}": [
      "prettier --write"
    ],
    "{,src/**/}*.{js,cjs,mjs,ts,cts,mts,tsx}": [
      "eslint --fix"
    ]
  },
  "config": {
    "default_environment": "prod"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.14.0",
    "axios": "1.21.1",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.23",
    "jwt-decode": "4.0.0",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-jhipster": "1.1.0",
    "react-redux": "9.3.1",
    "react-router": "8.5.1",
    "react-toastify": "11.2.0",
    "redux": "5.0.1",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.1",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "postcss-rtlcss": "6.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.1.0",
    "rimraf": "6.1.4",
    "sass": "1.108.1",
    "sonar-scanner": "3.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vitest-sonar-reporter": "3.0.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
