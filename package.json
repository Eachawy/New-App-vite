{
  "name": "jhipster-test",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "Description for Jhipster Test",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run webapp:prod --",
    "build-watch": "concurrently 'npm run webapp:build:dev -- --watch'",
    "ci:e2e:dev": "concurrently -k -s first -n application,e2e -c red,blue npm:app:start npm:e2e:headless",
    "ci:e2e:run": "concurrently -k -s first -n application,e2e -c red,blue npm:ci:e2e:server:start npm:e2e:headless",
    "ci:frontend:test": "npm run webapp:build:$npm_package_config_default_environment && npm run test",
    "clean-www": "rimraf target/classes/static/",
    "cleanup": "rimraf target/",
    "cypress": "cypress open --e2e",
    "e2e": "npm run e2e:cypress:headed --",
    "e2e:cypress": "cypress run --e2e --browser chrome",
    "e2e:cypress:headed": "npm run e2e:cypress -- --headed",
    "e2e:cypress:record": "npm run e2e:cypress -- --record",
    "e2e:dev": "concurrently -k -s first -n application,e2e -c red,blue npm:app:start npm:e2e",
    "e2e:devserver": "concurrently -k -s first -n backend,frontend,e2e -c red,yellow,blue npm:backend:start npm:start \"wait-on -t 180000 http-get://127.0.0.1:9000 && npm run e2e:headless -- -c baseUrl=http://localhost:9000\"",
    "pree2e:headless": "npm run ci:server:await --if-present",
    "e2e:headless": "npm run e2e:cypress --",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "prettier:check": "prettier --check \"{,.blueprint/**/,src/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,tsx,css,scss}\"",
    "prettier:format": "prettier --write \"{,.blueprint/**/,src/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,tsx,css,scss}\"",
    "sonar": "sonar-scanner",
    "start": "npm run webapp:dev --",
    "pretest": "npm run lint && npm run typecheck",
    "test": "npm run vitest-run --",
    "test:watch": "npm run vitest --",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vitest.json",
    "vitest": "vitest",
    "vitest-run": "vitest run --coverage",
    "watch": "concurrently 'npm run start' npm:backend:start",
    "webapp:build": "npm run clean-www && npm run webapp:build:dev --",
    "webapp:build:dev": "vite build",
    "webapp:build:prod": "vite build",
    "webapp:dev": "vite",
    "webapp:prod": "npm run clean-www && npm run webapp:build:prod --",
    "webapp:test": "npm run test --"
  },
  "allowScripts": {
    "cypress": true
  },
  "lint-staged": {
    "{,src/**/}*.{md,json,yml,html,css,scss}": [
      "prettier --write"
    ],
    "{,src/**/}*.{js,cjs,mjs,ts,cts,mts,tsx}": [
      "eslint --fix"
    ]
  },
  "config": {
    "default_environment": "prod"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@reduxjs/toolkit": "2.14.0",
    "axios": "1.21.1",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-jhipster": "1.1.0",
    "react-redux": "9.3.1",
    "react-router": "8.5.1",
    "react-toastify": "11.2.0",
    "react-top-loading-bar": "3.0.2",
    "redux": "5.0.1",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "concurrently": "10.0.7",
    "cypress": "16.2.1",
    "cypress-terminal-report": "7.4.0",
    "deepmerge": "^4.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.4",
    "eslint-plugin-prettier": "5.5.7",
    "generator-jhipster": "^7.9.4",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "postcss-rtlcss": "6.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.1.0",
    "react-infinite-scroll-component": "7.2.1",
    "rimraf": "6.1.4",
    "sass": "1.108.1",
    "sonar-scanner": "3.1.0",
    "swagger-ui-dist": "5.34.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.36.0",
    "vite": "8.3.7",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.1.0",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.5.1"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
