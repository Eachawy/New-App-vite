{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "es2024"],
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "app/*": ["./src/app/*"]
    },
    "importHelpers": true
  },
  "include": ["src/app"],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.spec.tsx"]
}
